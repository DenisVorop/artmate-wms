[Unit]
Description=Artmate WMS current production database backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=wms-deploy
Group=wms-deploy
WorkingDirectory=/opt/artmate-wms
UMask=0077
Environment=TZ=Europe/Moscow
ExecStart=/usr/local/bin/node /opt/artmate-wms/bin/backup-current.mjs
TimeoutStartSec=30min
