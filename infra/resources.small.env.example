# Append these non-secret settings to the protected production env on a 2 GiB VPS.
# One API process only; build images on CI, never on the small VPS.
# Limits are initial budgets, not measured peak usage or a production guarantee.
# Verify scan latency while imports and forecasting run before going live.
WMS_API_MEMORY=768m
WMS_API_CPUS=1.0
WMS_API_NODE_OPTIONS=--max-old-space-size=512
WMS_WEB_MEMORY=384m
WMS_WEB_NODE_OPTIONS=--max-old-space-size=256
WMS_POSTGRES_MEMORY=384m
WMS_EDGE_MEMORY=128m
