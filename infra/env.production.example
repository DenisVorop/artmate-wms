# EXAMPLE ONLY. init.mjs creates a protected config; never commit filled values.
# WMS_DOMAIN must be an exact HTTPS hostname, without scheme, path or port.
WMS_DOMAIN=wms.example.com
WMS_API_IMAGE=ghcr.io/OWNER/artmate-wms-api:sha-REPLACE
WMS_WEB_IMAGE=ghcr.io/OWNER/artmate-wms-web:sha-REPLACE
POSTGRES_USER=wms
POSTGRES_DB=artmate_wms
# Use generated hex: safe as both PostgreSQL password and URL component.
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_HEX
# Existing DB: original .data/marketplace-secret.key encoded as base64, not a new key.
WMS_MARKETPLACE_KEY=REPLACE_WITH_ORIGINAL_BASE64_KEY
WMS_PROXY_NETWORK=artmate_default
# Optional: pin infra images by digest before rollout.
POSTGRES_IMAGE=postgres:17-alpine
CADDY_IMAGE=caddy:2-alpine
